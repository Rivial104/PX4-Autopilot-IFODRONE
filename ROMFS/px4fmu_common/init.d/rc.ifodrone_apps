#!/bin/sh
#
# IfoDrone specific apps.
# mc_pos_control handles position/velocity PID.
# ifo_pos_control filter overrides attitude setpoint for IFODRONE body-frame thrust.
# ifo_att_control handles attitude stabilization and thrust passthrough.
#
# NOTE: Script variables are declared/initialized/unset in the rcS script.
#

#
# Start Control Allocator (required for ActuatorEffectivenessIfodrone)
#
control_allocator start

#
# Start standard MC Position Controller (position/velocity PID -> NED thrust)
#
mc_pos_control start

#
# Start IfoDrone Position Filter (rewrites attitude setpoint: level body, body-frame thrust)
#
ifo_pos_control start

#
# Start IfoDrone Attitude Controller (PD stabilization, thrust passthrough)
#
ifo_att_control start

#
# Start Hover Thrust Estimator (needed for thrust estimation)
#
mc_hover_thrust_estimator start

#
# Start Flight Mode Manager (required for mission/auto modes)
#
flight_mode_manager start

#
# Start Land Detector
#
land_detector start multicopter
