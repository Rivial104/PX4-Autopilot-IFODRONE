#!/bin/sh
#
# IfoDrone specific apps. Cascaded MC-style control chain:
#   ifo_pos_control : trajectory_setpoint → vehicle_attitude_setpoint (yaw + thrust_body)
#   ifo_att_control : attitude P          → vehicle_rates_setpoint (+ thrust_body passthrough)
#   mc_rate_control : rate PID            → vehicle_torque_setpoint + vehicle_thrust_setpoint
#   control_allocator: torque/thrust      → actuator_motors + actuator_servos (tilts)
#
# Single publisher per topic, identical chain in manual and offboard/mission.
#

#
# Compass retry.
#
# rc.board_sensors starts the QMC5883L at rcS:349, long before this file
# (rcS:485 -> rc.vehicle_setup). A failed probe there is SILENT: nothing
# advertises sensor_mag and the only symptom is commander's
# "Preflight Fail: Compass Sensor 0 missing" (magnetometerCheck.cpp, !exists).
# `status` returns 0 when running, -1 otherwise (I2CSPIDriverBase::module_status),
# so this is a no-op on a healthy boot.
# Options MUST precede 'start' - the I2C/SPI CLI stops parsing at the first
# non-option, so '-X'/'-a' placed after it are silently ignored.
#
if ! qmc5883l status
then
	echo "IFODRONE: compass not up after board sensors, retrying"

	if ! qmc5883l -X -a 13 start
	then
		qmc5883l -I -a 13 start
	fi
fi

control_allocator start

#
# Start IfoDrone Position Controller (trajectory_setpoint -> vehicle_attitude_setpoint)
#
ifo_pos_control start

#
# Start IfoDrone Attitude Controller (attitude P -> vehicle_rates_setpoint)
#
ifo_att_control start

#
# Start Rate Controller (rate PID -> vehicle_torque_setpoint + vehicle_thrust_setpoint)
#
mc_rate_control start


#
# Start Hover Thrust Estimator (needed for thrust estimation)
#
mc_hover_thrust_estimator start

#
# Start Flight Mode Manager (required for mission/auto modes)
#
flight_mode_manager start

#
# Start Land Detector
#
land_detector start multicopter
