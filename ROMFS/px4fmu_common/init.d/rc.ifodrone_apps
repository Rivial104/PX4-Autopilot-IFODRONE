#!/bin/sh
#
# IfoDrone specific apps — cascaded attitude/rate control.
#
# ifo_att_control : attitude P   → vehicle_rates_setpoint
# ifo_rate_control: rate PD      → vehicle_torque_setpoint
# ifo_pos_control : trajectory   → vehicle_thrust_setpoint
# control_allocator: torque/thrust → actuator outputs
#

control_allocator start
ifo_att_control start
ifo_rate_control start
ifo_pos_control start

#
# Start Hover Thrust Estimator (needed for thrust estimation)
#
mc_hover_thrust_estimator start

#
# Start Flight Mode Manager (required for mission/auto modes)
#
flight_mode_manager start

#
# Start Land Detector
#
land_detector start multicopter
