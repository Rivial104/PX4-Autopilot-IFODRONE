#!/bin/sh
#
# IfoDrone specific apps. Cascaded MC-style control chain:
#   ifo_pos_control : trajectory_setpoint → vehicle_attitude_setpoint (yaw + thrust_body)
#   ifo_att_control : attitude P          → vehicle_rates_setpoint (+ thrust_body passthrough)
#   mc_rate_control : rate PID            → vehicle_torque_setpoint + vehicle_thrust_setpoint
#   control_allocator: torque/thrust      → actuator_motors + actuator_servos (tilts)
#
# Single publisher per topic, identical chain in manual and offboard/mission.
#
#
if ! qmc5883l status
then
	echo "IFODRONE: compass not up after board sensors, retrying"
	usleep 100000

	if ! qmc5883l -X -a 13 -f 100000 start
	then
		usleep 200000

		if ! qmc5883l -X -a 13 -f 100000 start
		then
			usleep 400000

			if ! qmc5883l -X -a 13 -f 100000 start
			then
				usleep 800000

				if ! qmc5883l -X -a 13 -f 100000 start
				then
					usleep 1600000
					qmc5883l -X -a 13 -f 100000 start
				fi
			fi
		fi
	fi
fi

# QMC5883P fallback: a bench i2cdetect can ACK at 0x0d while the qmc5883l
# driver still reports the sensor missing, because several "QMC5883L
# compatible" GPS+compass modules actually carry the newer QMC5883P chip - same
# family name, different register map and WHOAMI, so qmc5883l's probe()
# rejects it even though the address answers. QMC5883P's own default address is
# 0x2c (44 decimal), external bus 1, same as qmc5883l otherwise. Harmless no-op
# if the L variant above already came up (status check first).
if ! qmc5883l status
then
	if ! qmc5883p status
	then
		qmc5883p -X -a 44 start
	fi
fi

#
# CRSF receiver on the board's dedicated RC pads (RC_SERIAL_PORT = /dev/ttyS4,
# boards/matek/h743-slim/src/board_config.h). This is NOT reachable through
# RC_CRSF_PRT_CFG - that param's choices are only Disabled/GPS1/TEL1..4, and
# ttyS4 has none of those labels in default.px4board. TEL3 carries a MAVLink
# telemetry backpack instead (MAV_0_CONFIG in the airframe) and must stay free
# for it - do not point RC_CRSF_PRT_CFG at TEL3, it will fight the backpack for
# the port. `status` before `start` keeps this a no-op if something else
# already brought the driver up.
#
if ! crsf_rc status
then
	crsf_rc start -d /dev/ttyS4
fi

control_allocator start

#
# Start IfoDrone Position Controller (trajectory_setpoint -> vehicle_attitude_setpoint)
#
ifo_pos_control start

#
# Start IfoDrone Attitude Controller (attitude P -> vehicle_rates_setpoint)
#
ifo_att_control start

#
# Start Rate Controller (rate PID -> vehicle_torque_setpoint + vehicle_thrust_setpoint)
#
mc_rate_control start


#
# Start Hover Thrust Estimator (needed for thrust estimation)
#
mc_hover_thrust_estimator start

#
# Start Flight Mode Manager (required for mission/auto modes)
#
flight_mode_manager start

#
# Start Land Detector
#
land_detector start multicopter
