#!/bin/sh
#
# IfoDrone specific apps.
# ifo_pos_control: trajectory_setpoint -> vehicle_thrust_setpoint (force, body frame).
#   Force is position's responsibility only — attitude does not participate.
# ifo_att_control: attitude stabilization -> vehicle_torque_setpoint (torque only).
#   Torque is attitude's responsibility only — position does not participate.
#
# NOTE: Script variables are declared/initialized/unset in the rcS script.
#

#
# Start Control Allocator (required for ActuatorEffectivenessIfodrone)
#
control_allocator start

#
# Start IfoDrone Position Controller (trajectory_setpoint -> vehicle_thrust_setpoint)
#
ifo_pos_control start

#
# Start IfoDrone Attitude Controller (attitude stabilization -> vehicle_torque_setpoint)
#
ifo_att_control start

#
# Start Hover Thrust Estimator (needed for thrust estimation)
#
mc_hover_thrust_estimator start

#
# Start Flight Mode Manager (required for mission/auto modes)
#
flight_mode_manager start

#
# Start Land Detector
#
land_detector start multicopter
