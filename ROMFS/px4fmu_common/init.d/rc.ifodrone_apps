#!/bin/sh
#
# IfoDrone specific apps. STOCK multicopter control cascade + a thin level adapter:
#   mc_pos_control vtol : trajectory_setpoint → mc_virtual_attitude_setpoint (tilted q_d + collective)
#   ifo_level_adapter   : virtual att sp      → vehicle_attitude_setpoint (LEVEL q_d + thrust_body[0/1/2])
#   mc_att_control      : attitude control    → vehicle_rates_setpoint (roll/pitch->0, yaw, thrust passthrough)
#   mc_rate_control     : rate PID            → vehicle_torque_setpoint + vehicle_thrust_setpoint
#   control_allocator   : torque/thrust       → actuator_motors + actuator_servos (tilts)
#
# The body is kept level (roll/pitch = 0); horizontal translation is realized by the side
# EDFs via thrust_body[0/1] in ActuatorEffectivenessIfodrone. mc_pos_control is started with
# "vtol" only to divert its output to mc_virtual_attitude_setpoint so the adapter is the sole
# publisher of vehicle_attitude_setpoint while position control is active.
#

control_allocator start
mc_rate_control start
mc_att_control start

mc_pos_control start vtol
ifo_level_adapter start

mc_hover_thrust_estimator start

flight_mode_manager start

#
# Start Land Detector
#
land_detector start multicopter
