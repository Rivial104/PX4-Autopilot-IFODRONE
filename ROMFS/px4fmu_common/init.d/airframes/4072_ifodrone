#!/bin/sh
#
# @name IFODRONE (Matek H743 Slim V3)
#
# @type Custom
# @class Copter
#
# @desc
# IFODRONE - Hybrid multicopter with 2 main Z-axis motors and 4 tilting side motors.
# Hardware airframe for Matek H743-Slim V3.
#
# Output mapping = PHYSICAL WIRING OF THE AIRCRAFT (as flown in lot1,
# commit f7888fe). The EDF order on S5..S8 is scrambled on purpose — it
# matches the actual cables. Do NOT renumber to a "clean" S3..S6 layout;
# that disconnects front/right/left EDFs (they end up on unused outputs).
#   MAIN1 (S1)  -> Motor 0  (top main,    function 101)
#   MAIN2 (S2)  -> Motor 1  (bottom main, function 102)
#   MAIN3 (S3)  -> free
#   MAIN4 (S4)  -> free
#   MAIN5 (S5)  -> Motor 4  (back EDF,    function 105)
#   MAIN6 (S6)  -> Motor 3  (right EDF,   function 104)
#   MAIN7 (S7)  -> Motor 5  (left EDF,    function 106)
#   MAIN8 (S8)  -> Motor 2  (front EDF,   function 103)
#   MAIN9 (S9)  -> Tilt servo 2 (back,    function 203)
#   MAIN10(S10) -> Tilt servo 3 (left,    function 204)
#   MAIN11(S11) -> Tilt servo 1 (right,   function 202)
#   MAIN12(S12) -> Tilt servo 0 (front,   function 201)
#
# @maintainer IFODRONE
#

. ${R}etc/init.d/rc.ifodrone_defaults

param set-default SYS_AUTOCONFIG 1
param set-default CA_AIRFRAME 90
param set-default CA_ROTOR_COUNT 6

# ============================================
# ROTOR GEOMETRY (must match SITL airframe)
# ============================================
# Motor 0: Top main
param set-default CA_ROTOR0_PX 0.0
param set-default CA_ROTOR0_PY 0.0
param set-default CA_ROTOR0_PZ 0.1
param set-default CA_ROTOR0_AX 0.0
param set-default CA_ROTOR0_AY 0.0
param set-default CA_ROTOR0_AZ -1.0
param set-default CA_ROTOR0_KM 0.4
param set-default CA_ROTOR0_CT 0.6

# Motor 1: Bottom main (counter-rotating CW, KM negative = CW in PX4 convention)
param set-default CA_ROTOR1_PX 0.0
param set-default CA_ROTOR1_PY 0.0
param set-default CA_ROTOR1_PZ -0.1
param set-default CA_ROTOR1_AX 0.0
param set-default CA_ROTOR1_AY 0.0
param set-default CA_ROTOR1_AZ -1.0
param set-default CA_ROTOR1_KM -0.4
param set-default CA_ROTOR1_CT 0.6

# Side EDFs (tiltable) - tilt servo IDs 1..4.
# SITL-validated geometry: BASE axes are HORIZONTAL (radial, AZ=0) and the
# resting down-tilt comes from IFO_TILT_HOVER below — the allocator rotates the
# axes to the actual tilt every cycle, so do NOT bake the tilt into the axes.
# CT 0.1 vs coax 0.6 = calibrated thrust ratio; KM 0 (EDF reaction unmodeled).
param set-default CA_ROTOR2_PX 0.535
param set-default CA_ROTOR2_PY 0.0
param set-default CA_ROTOR2_PZ 0.045
param set-default CA_ROTOR2_AX 1.0
param set-default CA_ROTOR2_AY 0.0
param set-default CA_ROTOR2_AZ 0.0
param set-default CA_ROTOR2_KM 0
param set-default CA_ROTOR2_CT 0.1
param set-default CA_ROTOR2_TILT 1

param set-default CA_ROTOR3_PX 0.0
param set-default CA_ROTOR3_PY 0.535
param set-default CA_ROTOR3_PZ 0.045
param set-default CA_ROTOR3_AX 0.0
param set-default CA_ROTOR3_AY 1.0
param set-default CA_ROTOR3_AZ 0.0
param set-default CA_ROTOR3_KM 0
param set-default CA_ROTOR3_CT 0.1
param set-default CA_ROTOR3_TILT 2

param set-default CA_ROTOR4_PX -0.535
param set-default CA_ROTOR4_PY 0.0
param set-default CA_ROTOR4_PZ 0.045
param set-default CA_ROTOR4_AX -1.0
param set-default CA_ROTOR4_AY 0.0
param set-default CA_ROTOR4_AZ 0.0
param set-default CA_ROTOR4_KM 0
param set-default CA_ROTOR4_CT 0.1
param set-default CA_ROTOR4_TILT 3

param set-default CA_ROTOR5_PX 0.0
param set-default CA_ROTOR5_PY -0.535
param set-default CA_ROTOR5_PZ 0.045
param set-default CA_ROTOR5_AX 0.0
param set-default CA_ROTOR5_AY -1.0
param set-default CA_ROTOR5_AZ 0.0
param set-default CA_ROTOR5_KM 0
param set-default CA_ROTOR5_CT 0.1
param set-default CA_ROTOR5_TILT 4

# ============================================
# TILT SERVO GEOMETRY
# Full mechanical range +-60 deg (unlike SITL's +-35): the resting point is
# tilted DOWN by IFO_TILT_HOVER, so headroom around it is asymmetric and the
# wider range keeps enough control authority on the down side.
# ============================================
param set-default CA_SV_TL_COUNT 4

# EDFs rest tilted DOWN (exhaust downward -> thrust gains a lift component).
# Negative angle = thrust axis rotated towards -Z (up) in the allocator's
# convention. The allocation trims to this angle with zero torque demand and
# the effectiveness matrix is linearized around it. VERIFY the direction on
# the bench: at disarm the ducts must visibly point down; if they point up,
# fix the servo linkage/PWM direction, not this parameter's sign.
param set-default IFO_TILT_HOVER -30.0

param set-default CA_SV_TL0_MINA -60.0
param set-default CA_SV_TL0_MAXA  60.0
param set-default CA_SV_TL0_TD 0
param set-default CA_SV_TL0_CT 0

param set-default CA_SV_TL1_MINA -60.0
param set-default CA_SV_TL1_MAXA  60.0
param set-default CA_SV_TL1_TD 90
param set-default CA_SV_TL1_CT 0

param set-default CA_SV_TL2_MINA -60.0
param set-default CA_SV_TL2_MAXA  60.0
param set-default CA_SV_TL2_TD 180
param set-default CA_SV_TL2_CT 0

param set-default CA_SV_TL3_MINA -60.0
param set-default CA_SV_TL3_MAXA  60.0
param set-default CA_SV_TL3_TD 270
param set-default CA_SV_TL3_CT 0

# ============================================
# PWM OUTPUT MAPPING - FMU MAIN (S1..S10)
# Function codes:
#   101..106 = Motor 1..6
#   201..204 = Servo 1..4
# ============================================

# ----- Motors: PHYSICAL WIRING AS FLOWN IN LOT1 (do not "clean up"!) -----
#   S1 -> Motor 0 top main    (101)
#   S2 -> Motor 1 bottom main (102)
#   S3, S4 -> free
#   S5 -> Motor 4 back EDF    (105)
#   S6 -> Motor 3 right EDF   (104)
#   S7 -> Motor 5 left EDF    (106)
#   S8 -> Motor 2 front EDF   (103)
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 0
param set-default PWM_MAIN_FUNC4 0
param set-default PWM_MAIN_FUNC5 103
param set-default PWM_MAIN_FUNC6 104
param set-default PWM_MAIN_FUNC7 106
param set-default PWM_MAIN_FUNC8 105

# Motor PWM range (standard 1000..2000 us; ESCs must be calibrated to this)
param set-default PWM_MAIN_MAX1 2000
param set-default PWM_MAIN_MAX2 2000
param set-default PWM_MAIN_MAX5 2000
param set-default PWM_MAIN_MAX6 2000
param set-default PWM_MAIN_MAX7 2000
param set-default PWM_MAIN_MAX8 2000

# Armed idle: 1020 us on all motors = ESC armed but props NOT spinning
# (a small margin above the 1000 us disarm level, below the typical ESC start
# threshold of ~1050-1080 us). Motors only spin once thrust is demanded.
# NOTE: the side EDFs receive the allocation idle IFO_EDF_TRIM (~0.2 -> about
# 1220 us) as soon as the vehicle is armed - that baseline is part of the
# differential-pair control design. If a dead-still bench arm is required,
# lower IFO_EDF_TRIM (at the cost of lateral/tilt control authority).
param set-default PWM_MAIN_MIN1 1020
param set-default PWM_MAIN_MIN2 1020
param set-default PWM_MAIN_MIN5 1020
param set-default PWM_MAIN_MIN6 1020
param set-default PWM_MAIN_MIN7 1020
param set-default PWM_MAIN_MIN8 1020

# Disarmed state: 1000 us = zero thrust / ESC standby.
# Do NOT use values below 1000 — some ESCs enter programming mode at <1000 us.
param set-default PWM_MAIN_DIS1 1000
param set-default PWM_MAIN_DIS2 1000
param set-default PWM_MAIN_DIS5 1000
param set-default PWM_MAIN_DIS6 1000
param set-default PWM_MAIN_DIS7 1000
param set-default PWM_MAIN_DIS8 1000

# ----- Tilt servos: S9..S12 (physical wiring as flown in lot1) -----
#   S9  -> Tilt servo 2 back  (203)
#   S10 -> Tilt servo 3 left  (204)
#   S11 -> Tilt servo 1 right (202)
#   S12 -> Tilt servo 0 front (201)
param set-default PWM_MAIN_FUNC9  203
param set-default PWM_MAIN_FUNC10 202
param set-default PWM_MAIN_FUNC11 204
param set-default PWM_MAIN_FUNC12 201

# Standard hobby servo range: 1000..2000 us maps linearly to -60..+60 deg
# (CA_SV_TL*_MINA/MAXA). Disarmed 1250 us = -30 deg = IFO_TILT_HOVER, so the
# EDFs rest tilted down both disarmed and at zero demand after arming.
# Bench-verify per servo/linkage that 1250 us really is 30 deg down; adjust
# the DIS values (not IFO_TILT_HOVER) for linkage asymmetries.
param set-default PWM_MAIN_MIN9  1000
param set-default PWM_MAIN_MIN10 1000
param set-default PWM_MAIN_MIN11 1000
param set-default PWM_MAIN_MIN12 1000
param set-default PWM_MAIN_MAX9  2000
param set-default PWM_MAIN_MAX10 2000
param set-default PWM_MAIN_MAX11 2000
param set-default PWM_MAIN_MAX12 2000
param set-default PWM_MAIN_DIS9  1250
param set-default PWM_MAIN_DIS10 1250
param set-default PWM_MAIN_DIS11 1250
param set-default PWM_MAIN_DIS12 1250

# ============================================
# SAFETY / SYSTEM
# ============================================
param set-default COM_RC_IN_MODE 2

# External mag (instance 2) mounted rotated: Yaw 270 (enum 6)
param set-default CAL_MAG2_ROT 6

# Battery: 6S Li-Po, 3.3 V/cell empty, 4.2 V/cell charged
param set-default BAT1_N_CELLS 6
param set-default BAT1_V_EMPTY 3.3
param set-default BAT1_V_CHARGED 4.2
# Measured divider/current scaling of this Matek board (from calibrated state)
# param set-default BAT1_V_DIV 11.0046
# param set-default BAT1_A_PER_V 40.0


# ============================================
# DRONECAN (GPS + compass are on the CAN bus!)
# ============================================
param set-default UAVCAN_ENABLE 3
param set-default UAVCAN_SUB_GPS 1

# ============================================
# SERIAL PORTS (survive param reset_all!)
# ============================================
# SiK telemetry radio on TEL1, GCS profile (MODE 0 = Normal, not Onboard)
param set-default MAV_1_CONFIG 101
param set-default MAV_1_MODE 0
param set-default MAV_1_RADIO_CTL 1
param set-default MAV_1_FLOW_CTRL 2
param set-default SER_TEL1_BAUD 57600

# RC receiver on TEL3 (CRSF)
param set-default RC_PORT_CONFIG 103
param set-default RC_INPUT_PROTO 6

# ============================================
# RC MAPPING
# ============================================
param set-default RC_MAP_FLTMODE 7
param set-default COM_FLTMODE1 8
param set-default COM_FLTMODE3 1
param set-default COM_FLTMODE4 1
param set-default COM_FLTMODE6 11

# Arm/disarm switch on channel 5 (switch, not momentary button)
param set-default RC_MAP_ARM_SW 5

# Airmode off: roll/pitch authority comes from the tilt servos, independent of
# motor throttle, so raising collective thrust to preserve RP authority is moot.
param set-default MC_AIRMODE 0

# IFODRONE position controller defaults
param set-default IFO_THR_XY_MAX 0.2
param set-default IFO_THR_HOVER 0.5

# Reduced side-EDF and tilt-servo command authority around their trims.
# Post-allocation gains stay 1.0 (honest allocation, same as SITL): authority
# is shaped by IFO_THR_XY_MAX and the tilt range instead. Values below 1 hide
# plant gain from the allocator - emergency knobs only.
param set-default IFO_EDF_GAIN 1.0
param set-default IFO_TILT_GAIN 1.0
param set-default IFO_EDF_TRIM 0.2

# Auto/takeoff yaw mode: hold heading (mode 4)
param set-default MPC_YAW_MODE 4
