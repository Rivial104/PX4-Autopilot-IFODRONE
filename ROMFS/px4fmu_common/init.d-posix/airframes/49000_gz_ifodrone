#!/bin/sh
#
# @name IfoDrone Airframe
#
# @description IfoDrone - Hybrid multicopter with 2 main Z-axis motors and 4 tilting side motors
#
# Motor configuration:
#   Main motors (0-1): Z-axis thrust + yaw control (differential)
#   Side motors (2-5): Tiltable, XY thrust + roll/pitch torque
#
# @maintainer Paweł Zawadzki essa@gmail.com
#

. ${R}etc/init.d/rc.ifodrone_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=ifodrone}

param set-default SIM_GZ_EN 1

param set-default SYS_AUTOCONFIG 1
param set-default SYS_AUTOSTART 49000

param set-default CA_AIRFRAME 90

# ============================================
# 6 MOTORS TOTAL
# ============================================
param set-default CA_ROTOR_COUNT 6

# ============================================
# MAIN MOTORS (0-1): Z-axis thrust + yaw
# ============================================

# Motor 0: Upper motor - CCW rotation
param set-default CA_ROTOR0_PX 0.0
param set-default CA_ROTOR0_PY 0.0
param set-default CA_ROTOR0_PZ 0.1
param set-default CA_ROTOR0_AX 0.0
param set-default CA_ROTOR0_AY 0.0
param set-default CA_ROTOR0_AZ -1.0
param set-default CA_ROTOR0_KM 0.4
param set-default CA_ROTOR0_CT 0.6
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_DIS1 0
param set-default SIM_GZ_EC_MIN1 100
param set-default SIM_GZ_EC_MAX1 1000

# Motor 1: Lower motor - CW rotation (KM negative = CW; GZ physical reversal via SIM_GZ_EC_REV=2)
param set-default CA_ROTOR1_PX 0.0
param set-default CA_ROTOR1_PY 0.0
param set-default CA_ROTOR1_PZ 0.1
param set-default CA_ROTOR1_AX 0.0
param set-default CA_ROTOR1_AY 0.0
param set-default CA_ROTOR1_AZ -1.0
param set-default CA_ROTOR1_KM -0.4
param set-default CA_ROTOR1_CT 0.6
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_DIS2 0
param set-default SIM_GZ_EC_MIN2 100
param set-default SIM_GZ_EC_MAX2 1000

# ============================================
# SIDE MOTORS (2-5): Tiltable EDF, HORIZONTAL at nominal (pure XY thrust)
# Positions match SDF exactly: Front, Right, Back, Left at 0.535m from center
# Axes lie horizontal (radial: ±X / ±Y, Z = 0) so at the servo-level neutral the
# EDFs are lateral thrusters and contribute no lift; the coaxial pair (rotors 0-1)
# carries hover lift. The tilt servos are biased to 0° (level) at hover
# (ActuatorEffectivenessIfodrone, HOVER_TILT_DEG = 0).
# ============================================

# Motor 2: Front EDF - horizontal +X (thrust forward), linked to tilt servo 0
param set-default CA_ROTOR2_PX 0.535
param set-default CA_ROTOR2_PY 0.0
param set-default CA_ROTOR2_PZ 0.045
param set-default CA_ROTOR2_AX 1.0
param set-default CA_ROTOR2_AY 0.0
param set-default CA_ROTOR2_AZ 0.0
param set-default CA_ROTOR2_KM 0
param set-default CA_ROTOR2_CT 0.5
param set-default CA_ROTOR2_TILT 1
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_DIS3 0
param set-default SIM_GZ_EC_MIN3 675
param set-default SIM_GZ_EC_MAX3 1000

# Motor 3: Right EDF - horizontal +Y (thrust right), linked to tilt servo 1
param set-default CA_ROTOR3_PX 0.0
param set-default CA_ROTOR3_PY 0.535
param set-default CA_ROTOR3_PZ 0.045
param set-default CA_ROTOR3_AX 0.0
param set-default CA_ROTOR3_AY 1.0
param set-default CA_ROTOR3_AZ 0.0
param set-default CA_ROTOR3_KM 0
param set-default CA_ROTOR3_CT 0.5
param set-default CA_ROTOR3_TILT 2
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_DIS4 0
param set-default SIM_GZ_EC_MIN4 675
param set-default SIM_GZ_EC_MAX4 1000

# Motor 4: Back EDF - horizontal -X (thrust backward), linked to tilt servo 2
param set-default CA_ROTOR4_PX -0.535
param set-default CA_ROTOR4_PY 0.0
param set-default CA_ROTOR4_PZ 0.045
param set-default CA_ROTOR4_AX -1.0
param set-default CA_ROTOR4_AY 0.0
param set-default CA_ROTOR4_AZ 0.0
param set-default CA_ROTOR4_KM 0
param set-default CA_ROTOR4_CT 0.5
param set-default CA_ROTOR4_TILT 3
param set-default SIM_GZ_EC_FUNC5 105
param set-default SIM_GZ_EC_DIS5 0
param set-default SIM_GZ_EC_MIN5 675
param set-default SIM_GZ_EC_MAX5 1000

# Motor 5: Left EDF - horizontal -Y (thrust left), linked to tilt servo 3
param set-default CA_ROTOR5_PX 0.0
param set-default CA_ROTOR5_PY -0.535
param set-default CA_ROTOR5_PZ 0.045
param set-default CA_ROTOR5_AX 0.0
param set-default CA_ROTOR5_AY -1.0
param set-default CA_ROTOR5_AZ 0.0
param set-default CA_ROTOR5_KM 0
param set-default CA_ROTOR5_CT 0.5
param set-default CA_ROTOR5_TILT 4
param set-default SIM_GZ_EC_FUNC6 106
param set-default SIM_GZ_EC_DIS6 0
param set-default SIM_GZ_EC_MIN6 675
param set-default SIM_GZ_EC_MAX6 1000

# ============================================
# TILT SERVOS (4 servos for 4 side motors)
# Commanded by ifo_att_control, consumed by ActuatorEffectivenessIfodrone and gz bridge
# ============================================
param set-default CA_SV_TL_COUNT 4

# Tilt 0: Front motor (rotor 2) - tilts around Y axis (90 deg)
param set-default CA_SV_TL0_MINA -75.0
param set-default CA_SV_TL0_MAXA 75.0
param set-default CA_SV_TL0_TD 0
param set-default CA_SV_TL0_CT 0
param set-default CA_SV0_SLEW 0.0
param set-default SIM_GZ_SV_FUNC1 201
param set-default SIM_GZ_SV_MINA1 -75.0
param set-default SIM_GZ_SV_MAXA1 75.0
param set-default SIM_GZ_SV_MIN1 1000
param set-default SIM_GZ_SV_DIS1 1875
param set-default SIM_GZ_SV_MAX1 2000

# Tilt 1: Right motor (rotor 3) - tilts around X axis (90 deg from front)
param set-default CA_SV_TL1_MINA -75.0
param set-default CA_SV_TL1_MAXA 75.0
param set-default CA_SV_TL1_TD 90
param set-default CA_SV_TL1_CT 0
param set-default CA_SV1_SLEW 0.0
param set-default SIM_GZ_SV_FUNC2 202
param set-default SIM_GZ_SV_MINA2 -75.0
param set-default SIM_GZ_SV_MAXA2 75.0
param set-default SIM_GZ_SV_MIN2 1000
param set-default SIM_GZ_SV_DIS2 1875
param set-default SIM_GZ_SV_MAX2 2000

# Tilt 2: Back motor (rotor 4) - tilts around Y axis (180 deg, opposite from front)
param set-default CA_SV_TL2_MINA -75.0
param set-default CA_SV_TL2_MAXA 75.0
param set-default CA_SV_TL2_TD 180
param set-default CA_SV_TL2_CT 0
param set-default CA_SV2_SLEW 0.0
param set-default SIM_GZ_SV_FUNC3 203
param set-default SIM_GZ_SV_MINA3 -75.0
param set-default SIM_GZ_SV_MAXA3 75.0
param set-default SIM_GZ_SV_MIN3 1000
param set-default SIM_GZ_SV_DIS3 1875
param set-default SIM_GZ_SV_MAX3 2000

# Tilt 3: Left motor (rotor 5) - tilts around X axis (270 deg, opposite from right)
param set-default CA_SV_TL3_MINA -75.0
param set-default CA_SV_TL3_MAXA 75.0
param set-default CA_SV_TL3_TD 270
param set-default CA_SV_TL3_CT 0
param set-default CA_SV3_SLEW 0.0
param set-default SIM_GZ_SV_FUNC4 204
param set-default SIM_GZ_SV_MINA4 -75.0
param set-default SIM_GZ_SV_MAXA4 75.0
param set-default SIM_GZ_SV_MIN4 1000
param set-default SIM_GZ_SV_DIS4 1875
param set-default SIM_GZ_SV_MAX4 2000

# ============================================
# FLIGHT CONTROLLER PARAMETERS
# ============================================
# ATTITUDE P-CONTROLLER (ifo_att_control -> vehicle_rates_setpoint)
# IFODRONE body is kept level: roll/pitch setpoint = 0.
# These gains control how aggressively the attitude error is converted to rate setpoints.
# ============================================
param set-default MC_ROLL_P 1.0
param set-default MC_PITCH_P 1.0
param set-default MC_YAW_P 0.48
param set-default MC_YAW_WEIGHT 0.4
# param set-default MC_ROLLRATE_MAX 220.0
# param set-default MC_PITCHRATE_MAX 220.0
# param set-default MC_YAWRATE_MAX 200.0

# ============================================
# RATE PID CONTROLLER (mc_rate_control -> torque + thrust)
# Inner loop: angular rate PID producing body torque.
# IFODRONE has small roll/pitch authority (tilt servos), so keep gains moderate.
# ============================================
param set-default MC_ROLLRATE_P 0.20
param set-default MC_ROLLRATE_I 0.10
param set-default MC_ROLLRATE_D 0.0003
param set-default MC_ROLLRATE_K 1.0
param set-default MC_PITCHRATE_P 0.30
param set-default MC_PITCHRATE_I 0.10
param set-default MC_PITCHRATE_D 0.0003
param set-default MC_PITCHRATE_K 1.0
param set-default MC_YAWRATE_P 0.22
param set-default MC_YAWRATE_I 0.01
param set-default MC_YAWRATE_D 0.0
param set-default MC_YAWRATE_K 1.0
param set-default MC_RR_INT_LIM 0.30
param set-default MC_PR_INT_LIM 0.30
param set-default MC_YR_INT_LIM 0.30

# ============================================
# THRUST / THROTTLE PARAMETERS (used by ifo_att_control manual mode)
# ============================================
param set-default MPC_THR_HOVER 0.5
param set-default MPC_THR_MAX 30.0
param set-default MPC_MANTHR_MIN 0.08

param set-default MC_AIRMODE 1

# SITL: Allow arming without RC and disable ESC failure detection
param set-default COM_RC_IN_MODE 0
param set-default COM_ARM_WO_GPS 1
param set-default COM_RCL_EXCEPT 4
param set-default FD_ACT_EN 0
param set-default FD_ACT_MOT_THR 0.0
param set-default FD_ESCS_EN 0
param set-default CBRK_SUPPLY_CHK 894281
param set-default NAV_RCL_ACT 0
param set-default NAV_DLL_ACT 0

# IFODRONE keeps the body level by design - the only torque source is the tilt
# servos, which produce small roll/pitch corrections. The default failure
# detector (FD_FAIL_R/P = 60 deg, 0.5 s) treats normal IFODRONE behaviour as a
# crash because any transient body roll triggers the position-recovery state.
# Disable the roll/pitch arming-failure check; we still keep ALT and battery FD.
# Setting to 0 disables the check (FailureDetector: max_roll > FLT_EPSILON is false).
param set-default FD_FAIL_R 0
param set-default FD_FAIL_P 0

# Auto/takeoff yaw mode: hold heading instead of yaw-along-trajectory.
# Mode 0 (default) makes FlightTaskAuto rotate the heading toward the next
# waypoint, which causes the IFODRONE to spin during HOLD because the smoothed
# velocity vector wanders. Mode 4 = no auto-yaw, hold last commanded heading.
param set-default MPC_YAW_MODE 4

param set-default SIM_GZ_EC_REV 0

param set-default CA_METHOD 0

# Side EDFs (motors 2-5) are unidirectional BLDCs — thrust outward only, never reversed.
# Bidirectional force along each body axis comes from the OPPOSING PAIR (front<->back for X,
# left<->right for Y); the allocator simply drives the motor whose axis matches the demand.
# They are NOT marked reversible (CA_R_REV off) — that would falsely tell the CA a single EDF
# can produce reverse-axis force. Instead they idle high (SIM_GZ_EC_MIN3-6 = 675, 67.5%) so the
# tilt servos always have baseline thrust to vector into roll/pitch torque.
# param set-default CA_R_REV 60
