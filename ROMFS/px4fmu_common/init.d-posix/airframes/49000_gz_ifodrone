#!/bin/sh
#
# @name IfoDrone Airframe
#
# @description IfoDrone - Hybrid multicopter with 2 main Z-axis motors and 4 tilting side motors
#
# Motor configuration:
#   Main motors (0-1): Z-axis thrust + yaw control (differential)
#   Side motors (2-5): Tiltable, XY thrust + roll/pitch torque
#
# @maintainer Paweł Zawadzki essa@gmail.com
#

. ${R}etc/init.d/rc.ifodrone_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=ifodrone}

param set-default SIM_GZ_EN 1

param set-default SYS_AUTOCONFIG 1
param set-default SYS_AUTOSTART 49000

param set-default CA_AIRFRAME 90

# ============================================
# 6 MOTORS TOTAL
# ============================================
param set-default CA_ROTOR_COUNT 6

# ============================================
# MAIN MOTORS (0-1): Z-axis thrust + yaw
# ============================================

# Motor 0: Upper motor - CCW rotation
param set-default CA_ROTOR0_PX 0.0
param set-default CA_ROTOR0_PY 0.0
param set-default CA_ROTOR0_PZ 0.1
param set-default CA_ROTOR0_AX 0.0
param set-default CA_ROTOR0_AY 0.0
param set-default CA_ROTOR0_AZ -1.0
param set-default CA_ROTOR0_KM 0.01
param set-default CA_ROTOR0_CT 1.0
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MAX1 1000

# Motor 1: Lower motor - CW rotation
param set-default CA_ROTOR1_PX 0.0
param set-default CA_ROTOR1_PY 0.0
param set-default CA_ROTOR1_PZ -0.1
param set-default CA_ROTOR1_AX 0.0
param set-default CA_ROTOR1_AY 0.0
param set-default CA_ROTOR1_AZ -1.0
param set-default CA_ROTOR1_KM 0.01
param set-default CA_ROTOR1_CT 1.0
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MAX2 1000

# ============================================
# SIDE MOTORS (2-5): Tiltable EDF for XY thrust
# Positions match SDF exactly: Front, Right, Back, Left at 0.535m from center
# Each motor can tilt to redirect thrust for orientation control
# ============================================

# Motor 2: Front EDF - tiltable around Y axis, linked to tilt servo 0
param set-default CA_ROTOR2_PX 0.535
param set-default CA_ROTOR2_PY 0.0
param set-default CA_ROTOR2_PZ 0.045
param set-default CA_ROTOR2_AX 1.0
param set-default CA_ROTOR2_AY 0.0
param set-default CA_ROTOR2_AZ 0.0
param set-default CA_ROTOR2_KM 0.01
param set-default CA_ROTOR2_CT 1.0
param set-default CA_ROTOR2_TILT 1
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MAX3 1000

# Motor 3: Right EDF - tiltable around X axis, linked to tilt servo 1
param set-default CA_ROTOR3_PX 0.0
param set-default CA_ROTOR3_PY -0.535
param set-default CA_ROTOR3_PZ 0.045
param set-default CA_ROTOR3_AX 0.0
param set-default CA_ROTOR3_AY -1.0
param set-default CA_ROTOR3_AZ 0.0
param set-default CA_ROTOR3_KM 0.01
param set-default CA_ROTOR3_CT 1.0
param set-default CA_ROTOR3_TILT 2
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_MIN4 0
param set-default SIM_GZ_EC_MAX4 1000

# Motor 4: Back EDF - tiltable around Y axis, linked to tilt servo 2
param set-default CA_ROTOR4_PX -0.535
param set-default CA_ROTOR4_PY 0.0
param set-default CA_ROTOR4_PZ 0.045
param set-default CA_ROTOR4_AX -1.0
param set-default CA_ROTOR4_AY 0.0
param set-default CA_ROTOR4_AZ 0.0
param set-default CA_ROTOR4_KM 0.01
param set-default CA_ROTOR4_CT 1.0
param set-default CA_ROTOR4_TILT 3
param set-default SIM_GZ_EC_FUNC5 105
param set-default SIM_GZ_EC_MIN5 0
param set-default SIM_GZ_EC_MAX5 1000

# Motor 5: Left EDF - tiltable around X axis, linked to tilt servo 3
param set-default CA_ROTOR5_PX 0.0
param set-default CA_ROTOR5_PY 0.535
param set-default CA_ROTOR5_PZ 0.045
param set-default CA_ROTOR5_AX 0.0
param set-default CA_ROTOR5_AY 1.0
param set-default CA_ROTOR5_AZ 0.0
param set-default CA_ROTOR5_KM 0.01
param set-default CA_ROTOR5_CT 1.0
param set-default CA_ROTOR5_TILT 4
param set-default SIM_GZ_EC_FUNC6 106
param set-default SIM_GZ_EC_MIN6 0
param set-default SIM_GZ_EC_MAX6 1000

# ============================================
# TILT SERVOS (4 servos for 4 side motors)
# Controlled internally by ActuatorEffectivenessIfodrone
# ============================================
param set-default CA_SV_TL_COUNT 4

# Tilt 0: Front motor (rotor 2) - tilts around Y axis (90 deg)
param set-default CA_SV_TL0_MINA -45.0
param set-default CA_SV_TL0_MAXA 45.0
param set-default CA_SV_TL0_TD 90
param set-default CA_SV_TL0_CT 1
param set-default SIM_GZ_SV_FUNC1 201
param set-default SIM_GZ_SV_MINA1 -45.0
param set-default SIM_GZ_SV_MAXA1 45.0
param set-default SIM_GZ_SV_MIN1 0
param set-default SIM_GZ_SV_MAX1 1000

# Tilt 1: Right motor (rotor 3) - tilts around X axis (0 deg)
param set-default CA_SV_TL1_MINA -45.0
param set-default CA_SV_TL1_MAXA 45.0
param set-default CA_SV_TL1_TD 0
param set-default CA_SV_TL1_CT 1
param set-default SIM_GZ_SV_FUNC2 202
param set-default SIM_GZ_SV_MINA2 -90.0
param set-default SIM_GZ_SV_MAXA2 90.0
param set-default SIM_GZ_SV_MIN2 0
param set-default SIM_GZ_SV_MAX2 1000

# Tilt 2: Back motor (rotor 4) - tilts around Y axis (90 deg, opposite)
param set-default CA_SV_TL2_MINA -45.0
param set-default CA_SV_TL2_MAXA 45.0
param set-default CA_SV_TL2_TD 270
param set-default CA_SV_TL2_CT 1
param set-default SIM_GZ_SV_FUNC3 203
param set-default SIM_GZ_SV_MINA3 -90.0
param set-default SIM_GZ_SV_MAXA3 90.0
param set-default SIM_GZ_SV_MIN3 0
param set-default SIM_GZ_SV_MAX3 1000

# Tilt 3: Left motor (rotor 5) - tilts around X axis (180 deg, opposite)
param set-default CA_SV_TL3_MINA -45.0
param set-default CA_SV_TL3_MAXA 45.0
param set-default CA_SV_TL3_TD 180
param set-default CA_SV_TL3_CT 1
param set-default SIM_GZ_SV_FUNC4 204
param set-default SIM_GZ_SV_MINA4 -90.0
param set-default SIM_GZ_SV_MAXA4 90.0
param set-default SIM_GZ_SV_MIN4 0
param set-default SIM_GZ_SV_MAX4 1000

# ============================================
# FLIGHT CONTROLLER PARAMETERS
# ============================================
param set-default MC_AIRMODE 1

# SITL: Allow arming without RC and disable ESC failure detection
param set-default COM_RC_IN_MODE 4
param set-default COM_ARM_WO_GPS 1
param set-default COM_RCL_EXCEPT 4
param set-default FD_ACT_EN 0
param set-default FD_ACT_MOT_THR 0.0
param set-default FD_ESCS_EN 0
param set-default CBRK_SUPPLY_CHK 894281
param set-default NAV_RCL_ACT 0
param set-default NAV_DLL_ACT 0

# IFODRONE position filter: enable attitude setpoint override
param set-default IFO_POS_MODE 1

# mc_pos_control params for IFODRONE
param set-default MPC_THR_HOVER 0.65
param set-default MPC_TILTMAX_AIR 89
