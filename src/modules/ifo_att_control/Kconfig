menuconfig MODULES_IFO_ATT_CONTROL
	bool "ifo_att_control"
	default n
	---help---
		Enable support for ifo_att_control

menuconfig USER_IFO_ATT_CONTROL
	bool "ifo_att_control running as userspace module"
	default y
	depends on BOARD_PROTECTED && MODULES_IFO_ATT_CONTROL
	---help---
		Put ifo_att_control in userspace memory
